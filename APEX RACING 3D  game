        b('ACCELERATION', 100 - (s.z - 2.4) / 12.6 * 90, '0-100 ' + s.z + 's') +
        b('HANDLING', s.hd * 10, s.hd + '/10') +
        b('BRAKING', (12 + s.hd * 2.6) / 36 * 100, '');
      $('modes').innerHTML = ['easy', 'medium', 'hard'].map(m => `<button class="o ${mode === m ? 'on' : ''}" data-m="${m}">${m.toUpperCase()}</button>`).join('');
    }

    $('menu').addEventListener('click', e => {
      const x = e.target.closest('[data-i],[data-m]');
      if (!x) return;
      if (x.dataset.i !== undefined) { sel = +x.dataset.i; setPV(); }
      else mode = x.dataset.m;
      ui();
    });
    setPV();
    ui();

    /* ---------- race ---------- */
    let racers = [], P = null, raceT = 0, rt = 0, laps = 3, camM = 0, score = 0, lastRank = 1, bestLap = 0, lapStart = 0, lapN = 0, wwT = 0, camYaw = 0, cdn = -1;
    const tv = new THREE.Vector3();
    const key = c => c.fin ? 1e9 - c.finT : c.pr,
          ranked = () => racers.slice().sort((a, b) => key(b) - key(a)),
          fmt = s => Math.floor(s / 60) + ':' + (s % 60).toFixed(1).padStart(4, '0'),
          ord = n => n + (['th', 'st', 'nd', 'rd'][n % 100 > 10 && n % 100 < 14 ? 0 : n % 10 < 4 ? n % 10 : 0]);

    function toast(s) {
      const e = $('tst');
      e.textContent = s;
      e.classList.remove('on');
      void e.offsetWidth;
      e.classList.add('on');
    }

    function cleanup() {
      racers.forEach(c => { scene.remove(c.m); if (c.v) killVoice(c.v); });
      racers = [];
      P = null;
    }

    function startRace() {
      audio();
      cleanup();
      const md = MD[mode], tot = md.n + 1;
      laps = md.laps;
      const order = V.map((v, i) => i).sort((a, b) => V[a].top - V[b].top), me = order.indexOf(sel);
      let pool = order.filter(i => i !== sel);
      if (mode === 'easy') {
        const low = pool.filter(i => order.indexOf(i) < me).reverse();
        pool = low.concat(pool.filter(i => !low.includes(i)));
      } else pool.sort(() => Math.random() - .5);

      const ps = Math.min(md.slot, tot - 1), ids = [];
      let q = 0;
      for (let k = 0; k < tot; k++) ids.push(k === ps ? sel : pool[q++]);

      ids.forEach((id, k) => {
        const sp = V[id], isP = k === ps, dist = 12 + (k >> 1) * 10, lat = (k % 2 ? -1 : 1) * 3.6, i0 = ((NS - Math.round(dist / ds)) % NS + NS) % NS;
        const c = {
          sp,
          cfg: { cyl: sp.eg[0], idle: sp.eg[1], red: sp.eg[2], G: sp.eg[3], e: sp.eg[4], tb: sp.eg[5] },
          isP,
          m: sh(carModel(sp)),
          x: px[i0] + Math.cos(th[i0]) * lat,
          z: pz[i0] - Math.sin(th[i0]) * lat,
          h: th[i0],
          vx: 0, vz: 0, i: i0, pi: i0, pr: -dist, d: 0, vf: 0, sl: 0, st: 0,
          nit: 100, nOn: 0, wasN: 0, eng: false, es: 'crank', et: 0, blip: 0, rf: .2, gear: 1,
          lane: rnd(-3, 3), skill: md.sk * rnd(.95, 1.03),
          fin: 0, finT: 0, off: 0, lastThr: 0, athr: 0, pit: 0, roll: 0, auto: false
        };
        c.vt = sp.top / 3.6 * SC;
        c.a0 = (100 / 3.6 * SC / sp.z) * 1.4;
        c.brk = 12 + sp.hd * 2.6;
        c.glat = 16 + sp.hd * 2.6;
        scene.add(c.m);
        if (AC) c.v = mkVoice(c.cfg, isP);
        racers.push(c);
        if (isP) P = c;
      });

      S('crank');
      state = 'ready';
      rt = 0;
      raceT = 0;
      score = 0;
      lastRank = ps + 1;
      lapN = 0;
      lapStart = 0;
      bestLap = 0;
      cdn = -1;
      wwT = 0;
      $('menu').style.display = 'none';
      $('res').style.display = 'none';
      $('hud').style.display = 'block';
      $('hint').style.display = 'block';
    }

    function drive(c, thr, steer, brake, hb, nit, dt) {
      const fx = Math.sin(c.h), fz = Math.cos(c.h), lx = Math.cos(c.h), lz = -Math.sin(c.h);
      let vf = c.vx * fx + c.vz * fz, vl = c.vx * lx + c.vz * lz;
      const top = c.vt * (nit ? 1.22 : 1) * (c.off ? .55 : 1);

      if (!c.eng) thr = Math.min(thr, 0);
      if (thr > 0) vf += thr * c.a0 * (nit ? 1.8 : 1) * Math.max(0, 1 - Math.pow(Math.max(vf, 0) / top, 1.7)) * dt;
      else if (thr < 0) {
        if (vf > 1) vf -= c.brk * dt;
        else vf = Math.max(vf - c.a0 * .6 * dt, -c.vt * .25);
      }

      if (brake) vf -= Math.sign(vf) * Math.min(Math.abs(vf), c.brk * dt);
      if (hb) vf -= Math.sign(vf) * Math.min(Math.abs(vf), 9 * dt);
      vf -= vf * (.018 + (c.off ? .6 : 0)) * dt + Math.sign(vf) * Math.min(Math.abs(vf), (thr === 0 ? 1.2 : .2) * dt);
      if (vf > top) vf -= (vf - top) * 1.5 * dt;

      vl *= Math.exp(-(hb ? 1.1 : 6 + c.sp.hd * .5) * dt * (c.off ? .7 : 1));
      const ym = Math.min(1.1 + c.sp.hd * .11, c.glat * .9 / Math.max(Math.abs(vf), 3)) * (hb ? 1.5 : 1);
      c.h += steer * ym * (vf >= 0 ? 1 : -1) * cl(Math.abs(vf) / 3, 0, 1) * dt;

      const nfx = Math.sin(c.h), nfz = Math.cos(c.h), nlx = Math.cos(c.h), nlz = -Math.sin(c.h);
      c.vx = nfx * vf + nlx * vl;
      c.vz = nfz * vf + nlz * vl;
      c.x += c.vx * dt;
      c.z += c.vz * dt;
      c.vf = vf;
      c.sl = vl;
    }

    function aiCtl(c) {
      const v = c.vf, look = Math.floor(7 + Math.abs(v) * .28), j = (c.i + look) % NS,
            ln = c.lane * (1 - cl(cv[j] * 40, 0, 1)),
            tx = px[j] + Math.cos(th[j]) * ln - c.x,
            tz = pz[j] - Math.sin(th[j]) * ln - c.z,
            err = wrap(Math.atan2(tx, tz) - c.h);
      let km = 0;
      const la = Math.floor(cl(v * v / (2 * c.brk) / ds + 10, 10, 90));
      for (let k = 0; k < la; k += 3) km = Math.max(km, cv[(c.i + k) % NS]);
      const vt = Math.min(c.vt * c.skill * .98, Math.sqrt(c.glat * .78 * c.skill / Math.max(km, 1e-3)));
      return { s: cl(err * 2.4, -1, 1), t: v < vt ? 1 : 0, b: v > vt * 1.06 };
    }

    function trk(c) {
      let bi = c.i, bd = 1e18;
      for (let o = -14; o <= 14; o++) {
        const j = (c.i + o + NS) % NS, dx = c.x - px[j], dz = c.z - pz[j], d = dx * dx + dz * dz;
        if (d < bd) { bd = d; bi = j; }
      }
      let di = bi - c.pi;
      if (di > NS / 2) di -= NS;
      if (di < -NS / 2) di += NS;
      c.pr += di * ds;
      c.pi = bi;
      c.i = bi;
      c.d = (c.x - px[bi]) * Math.cos(th[bi]) - (c.z - pz[bi]) * Math.sin(th[bi]);

      const lim = HW + 5.5;
      if (Math.abs(c.d) > lim) {
        const sg = Math.sign(c.d), ex = Math.abs(c.d) - lim, lx = Math.cos(th[bi]) * sg, lz = -Math.sin(th[bi]) * sg;
        c.x -= lx * ex;
        c.z -= lz * ex;
        const vn = c.vx * lx + c.vz * lz;
        if (vn > 0) {
          c.vx -= lx * vn * 1.5;
          c.vz -= lz * vn * 1.5;
          c.vx *= .9;
          c.vz *= .9;
          if (vn > 6 && c.isP && t - lastThud > .2) { S('thud'); lastThud = t; }
        }
      }
      c.off = Math.abs(c.d) > HW + 2.2;
    }

    function step(dt) {
      t += dt;
      const go = state !== 'ready';
      if (state === 'ready') {
        rt += dt;
        const n = rt < 1.2 ? -1 : rt < 2.2 ? 3 : rt < 3.2 ? 2 : rt < 4.2 ? 1 : 0;
        if (n !== cdn) {
          cdn = n;
          if (n > 0) { S('b1'); }
          else if (n === 0) { S('b2'); state = 'race'; toast('GO!'); }
          $('cd').textContent = n < 0 ? 'ENGINE START' : n > 0 ? n : 'GO!';
        }
      } else if (rt < 5.2) {
        rt += dt;
        if (rt >= 5.2) $('cd').textContent = '';
      }

      if (state === 'race' || state === 'fin') raceT += dt;
      const up = keys.KeyW || keys.ArrowUp,
            dn = keys.KeyS || keys.ArrowDown,
            sI = ((keys.KeyA || keys.ArrowLeft) ? 1 : 0) - ((keys.KeyD || keys.ArrowRight) ? 1 : 0);

      for (const c of racers) {
        let thr = 0, brake = false, steer = 0, hb = false, nit = false;
        if (c.es === 'crank') {
          c.et += dt;
          if (c.et > 1.05) { c.es = 'on'; c.eng = true; c.blip = 1; }
        }
        if (c.blip > 0) c.blip -= dt * 1.3;

        if (c.isP && !c.auto) {
          c.st += (sI - c.st) * Math.min(1, dt * 7);
          steer = c.st;
          if (go) {
            if (up) thr = 1;
            if (dn) { if (c.vf > 1) brake = true; else thr = -1; }
            hb = !!keys.Space;
            nit = !!keys.ShiftLeft && c.nit > 2 && c.vf > 3 && !!up && c.eng;
          } else brake = true;
        } else {
          const a = aiCtl(c);
          steer = a.s;
          thr = go ? a.t : 0;
          brake = go ? a.b : true;
        }

        c.nOn = nit ? 1 : 0;
        if (nit) c.nit = Math.max(0, c.nit - 28 * dt);
        else c.nit = Math.min(100, c.nit + 5 * dt);
        if (c.wasN && !nit && c.isP) S('bov');
        c.wasN = nit;

        drive(c, thr, steer, brake, hb, nit, dt);
        trk(c);
        c.athr = Math.max(0, thr);
        c.m.position.set(c.x, 0, c.z);
        c.pit += ((-thr * .02 + (brake ? .03 : 0)) - c.pit) * Math.min(1, dt * 6);
        c.roll += (-cl(c.sl * .01, -.09, .09) - c.roll) * Math.min(1, dt * 6);
        c.m.rotation.set(c.pit, c.h, c.roll);

        const u = c.m.userData;
        u.w.forEach((w, q) => {
          w.spin.rotation.x += c.vf * dt / w.r;
          if (q < 2) w.rotation.y = steer * .4;
        });
        u.tl.emissiveIntensity = brake || thr < 0 ? 3 : .6;
        u.nf.forEach(f => {
          f.visible = !!c.nOn;
          f.scale.set(1, .7 + Math.random() * .6, 1);
        });

        if (!c.fin && c.pr >= laps * TL) {
          c.fin = 1;
          c.finT = raceT;
          c.auto = true;
          if (c.isP) {
            state = 'fin';
            toast('FINISH!');
            setTimeout(showRes, 3500);
          }
        }
      }

      for (let i = 0; i < racers.length; i++) {
        for (let j = i + 1; j < racers.length; j++) {
          const a = racers[i], b = racers[j], dx = a.x - b.x, dz = a.z - b.z, d = Math.hypot(dx, dz);
          if (d < 4 && d > 1e-3) {
            const nx = dx / d, nz = dz / d, ov = (4 - d) / 2;
            a.x += nx * ov;
            a.z += nz * ov;
            b.x -= nx * ov;
            b.z -= nz * ov;
            const rv = (a.vx - b.vx) * nx + (a.vz - b.vz) * nz;
            if (rv < 0) {
              const j2 = -rv * .5;
              a.vx += nx * j2;
              a.vz += nz * j2;
              b.vx -= nx * j2;
              b.vz -= nz * j2;
              if (-rv > 4 && (a.isP || b.isP) && t - lastThud > .2) { S('thud'); lastThud = t; }
            }
          }
        }
      }

      const rk = ranked(), pos = rk.indexOf(P) + 1;
      if (go && !P.fin) {
        score += Math.max(0, P.vf) * dt * .12 + (Math.abs(P.sl) > 5 && P.vf > 12 ? dt * 60 : 0);
        if (pos < lastRank) {
          const b = 150 * (lastRank - pos);
          score += b;
          toast('OVERTAKE +' + b);
        }
      }
      lastRank = pos;

      const ln = Math.max(0, Math.floor(P.pr / TL));
      if (ln !== lapN && ln < laps && go) {
        const lt = raceT - lapStart;
        lapStart = raceT;
        if (!bestLap || lt < bestLap) bestLap = lt;
        toast('LAP ' + ln + ' · ' + fmt(lt));
        lapN = ln;
      }

      const dot = Math.sin(P.h) * Math.sin(th[P.i]) + Math.cos(P.h) * Math.cos(th[P.i]);
      wwT = (dot < -.3 && P.vf > 3) ? wwT + dt : 0;
      $('ww').style.display = wwT > 1 ? 'block' : 'none';

      racers.forEach(c => engTick(c, c.isP ? (keys.KeyW || keys.ArrowUp ? 1 : 0) * (state === 'ready' || state === 'race' ? 1 : 0) : c.athr, dt));
      sfxTick(P);

      camYaw += wrap(P.h - camYaw) * Math.min(1, dt * (camM === 2 ? 20 : 4));
      const cx = Math.sin(camYaw), cz = Math.cos(camYaw), sp = Math.abs(P.vf),
            [d, hh] = [[9 + P.sp.L * .3, 3.2 + P.sp.ry * .4], [15, 6], [-.2, P.sp.ry + .12]][camM];
      cam.position.lerp(tv.set(P.x - cx * d, hh, P.z - cz * d), camM === 2 ? 1 : Math.min(1, dt * 9));
      cam.lookAt(P.x + cx * 12, camM === 2 ? P.sp.ry : 1.2, P.z + cz * 12);
      cam.fov = 66 + sp * .35 + (P.nOn ? 10 : 0);
      cam.updateProjectionMatrix();

      sun.position.set(P.x - 50, 90, P.z + 40);
      sun.target.position.set(P.x, 0, P.z);

      $('pos').innerHTML = ord(pos) + ' <small>/ ' + racers.length + '</small>';
      $('lp').textContent = 'LAP ' + Math.min(laps, ln + 1) + '/' + laps + ' · ' + fmt(raceT) + ' · ' + MD[mode].n + ' rivals · ' + mode.toUpperCase();
      $('sc').textContent = 'SCORE ' + (score | 0);
      $('sv').textContent = Math.round(Math.abs(P.vf) / SC * 3.6);
      $('gr').textContent = P.cfg.e === 'e' ? 'D' : P.vf < -.5 ? 'R' : P.vf < .5 ? 'N' : P.gear;
      $('nt').style.width = P.nit + '%';
      $('rp').style.width = (P.es === 'on' ? Math.max(P.rf, .8 * Math.max(0, P.blip)) : 0) * 100 + '%';
      map();
    }

    const mc = $('map'), g2 = mc.getContext('2d'), mnx = Math.min(...px), mnz = Math.min(...pz),
          msc = 160 / Math.max(Math.max(...px) - mnx, Math.max(...pz) - mnz),
          mbg = document.createElement('canvas');
    mbg.width = mbg.height = 180;
    {
      const x = mbg.getContext('2d');
      x.strokeStyle = '#cfd6e6';
      x.lineWidth = 5;
      x.lineJoin = 'round';
      x.beginPath();
      for (let i = 0; i <= NS; i += 6) {
        const k = i % NS;
        const X = 10 + (px[k] - mnx) * msc, Y = 10 + (pz[k] - mnz) * msc;
        i ? x.lineTo(X, Y) : x.moveTo(X, Y);
      }
      x.stroke();
      x.fillStyle = '#fff';
      x.fillRect(10 + (px[0] - mnx) * msc - 4, 10 + (pz[0] - mnz) * msc - 1, 8, 3);
    }

    function map() {
      g2.clearRect(0, 0, 180, 180);
      g2.drawImage(mbg, 0, 0);
      for (const c of racers) {
        g2.fillStyle = c.isP ? '#35ffe0' : '#ff3b3b';
        g2.beginPath();
        g2.arc(10 + (c.x - mnx) * msc, 10 + (c.z - mnz) * msc, c.isP ? 5 : 3.5, 0, 7);
        g2.fill();
      }
    }

    function showRes() {
      if (state === 'done') return;
      state = 'done';
      S('off');
      racers.forEach(c => { c.es = 'off'; });
      const rk = ranked(), pos = rk.indexOf(P) + 1, bonus = Math.max(0, racers.length - pos) * 400;
      score += bonus;
      $('rt').textContent = pos === 1 ? '🏆 YOU WIN!' : 'FINISHED ' + ord(pos);
      $('rs').textContent = 'Score: ' + (score | 0) + '  ·  Best lap: ' + (bestLap ? fmt(bestLap) : '-') + '  ·  ' + P.sp.n + ' · ' + mode.toUpperCase();
      $('tb').innerHTML = rk.map((c, i) => `<tr class="${c.isP ? 'me' : ''}"><td>${i + 1}</td><td>${c.sp.n}${c.isP ? ' (YOU)' : ''}</td><td>${c.fin ? fmt(c.finT) : 'racing…'}</td></tr>`).join('');
      $('res').style.display = 'flex';
    }

    function loop(ts) {
      requestAnimationFrame(loop);
      const dt = Math.min(.05, (ts - last) / 1000 || 0);
      last = ts;
      if (state === 'menu') {
        t += dt;
        pvC.rotation.y = t * .5;
        pvC.userData.w.forEach(w => w.spin.rotation.x += dt * 4);
        cam.position.set(1500 + 4, 2.2, 1509);
        cam.lookAt(1500, .9, 1500);
        cam.fov = 50;
        cam.updateProjectionMatrix();
        sun.position.set(1470, 80, 1530);
        sun.target.position.set(1500, 0, 1500);
      } else if (state === 'done') {
        t += dt;
        racers.forEach(c => { if (c.isP) return; });
        step(dt);
      } else step(dt);
      sky.position.copy(cam.position);
      R.render(scene, cam);
    }
    requestAnimationFrame(loop);

    addEventListener('keydown', e => {
      if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.code)) e.preventDefault();
      if (!e.repeat && P && state !== 'menu') {
        if (e.code === 'KeyC') camM = (camM + 1) % 3;
        if (e.code === 'KeyE' && state !== 'done') {
          if (P.es === 'on') { P.es = 'off'; P.eng = false; S('off'); }
          else if (P.es === 'off') { P.es = 'crank'; P.et = 0; S('crank'); }
        }
      }
      keys[e.code] = true;
    });

    addEventListener('keyup', e => keys[e.code] = false);
    document.addEventListener('pointerdown', audio);
    document.addEventListener('click', e => { if (e.target.closest('button')) S('click'); });
    $('start').onclick = startRace;
    $('again').onclick = startRace;
    $('gar').onclick = () => {
      cleanup();
      state = 'menu';
      $('res').style.display = 'none';
      $('hud').style.display = 'none';
      $('menu').style.display = 'flex';
      $('cd').textContent = '';
    };
  </script>
</body>
</html>
