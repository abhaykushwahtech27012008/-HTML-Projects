<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>APEX RACING 3D</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
      overflow: hidden;
      background: #0a0d18;
      font-family: Impact, 'Arial Black', sans-serif;
      color: #fff;
      user-select: none;
    }

    canvas {
      display: block;
    }

    .ov {
      position: fixed;
      inset: 0;
      display: flex;
      justify-content: space-between;
      padding: 1em;
      z-index: 5;
    }

    #menu {
      background: linear-gradient(90deg, rgba(8, 10, 20, .93), rgba(8, 10, 20, .65) 42%, transparent 66%);
    }

    .L {
      width: min(48%, 34em);
      display: flex;
      flex-direction: column;
      gap: .5em;
      overflow: hidden;
    }

    .R {
      width: min(38%, 24em);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: .5em;
      text-align: center;
    }

    h1 {
      font-size: 2em;
      letter-spacing: .05em;
      text-shadow: 0 0 .5em #00e5ff;
    }

    h2 {
      font-size: 1.3em;
      font-weight: 400;
    }

    #grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: .35em;
      overflow: auto;
      padding-right: .3em;
    }

    .cb {
      font-size: .62em;
      text-align: left;
      padding: .5em .7em;
      background: #1c2236;
      color: #fff;
      border: 2px solid #333b58;
      font-family: inherit;
    }

    .cb span {
      opacity: .7;
      font: .8em system-ui;
    }

    .cb.on {
      border-color: #00e5ff;
      background: #0d3a4a;
    }

    .sub {
      font: .58em/1.6 system-ui, sans-serif;
      opacity: .88;
    }

    .st {
      font: .55em system-ui, sans-serif;
      display: flex;
      align-items: center;
      gap: .5em;
      margin-top: .25em;
    }

    .st i {
      flex: 1;
      height: .55em;
      background: #2a2f45;
      border-radius: .3em;
      overflow: hidden;
    }

    .st b {
      display: block;
      height: 100%;
      background: #ffb703;
    }

    .st em {
      width: 6em;
      text-align: right;
      font-style: normal;
    }

    .row {
      display: flex;
      gap: .4em;
      justify-content: center;
    }

    button {
      font: inherit;
      font-size: 1em;
      padding: .5em 1.3em;
      background: #ffb703;
      color: #10131f;
      border: 0;
      border-radius: .2em;
      cursor: pointer;
    }

    button:active {
      background: #fff;
    }

    .o {
      font-size: .65em;
      flex: 1;
      background: #1c2236;
      color: #fff;
      border: 2px solid #333b58;
    }

    .o.on {
      background: #e63946;
      border-color: #fff;
    }

    #hud {
      position: fixed;
      inset: 0;
      pointer-events: none;
      display: none;
      z-index: 3;
      text-shadow: 2px 2px 0 #000;
    }

    #pos {
      position: absolute;
      top: .5em;
      left: .8em;
      font-size: 2.6em;
      line-height: 1;
      color: #ffd23f;
    }

    #pos small {
      font-size: .45em;
      color: #fff;
    }

    #lp {
      position: absolute;
      top: .7em;
      left: 50%;
      transform: translateX(-50%);
      font: 700 .75em system-ui;
      background: #000a;
      padding: .4em 1em;
      border-radius: .3em;
    }

    #sc {
      position: absolute;
      top: .7em;
      right: .8em;
      font-size: 1.3em;
      color: #7CFC6A;
    }

    #map {
      position: absolute;
      left: .8em;
      bottom: .8em;
      width: 9em;
      height: 9em;
      border-radius: .5em;
      background: #0008;
      border: 2px solid #fff6;
    }

    #spd {
      position: absolute;
      bottom: .6em;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      font-size: 2.6em;
      line-height: 1;
    }

    #spd small {
      font-size: .35em;
    }

    #gr {
      font-size: .45em;
      color: #00e5ff;
    }

    #bars {
      position: absolute;
      right: .8em;
      bottom: .8em;
      width: 12em;
      font: 700 .5em system-ui;
    }

    .bar {
      height: .9em;
      background: #0008;
      border: 2px solid #000;
      margin: .2em 0 .6em;
    }

    .bar div {
      height: 100%;
      width: 0;
    }

    #nt {
      background: linear-gradient(90deg, #1e90ff, #7fe7ff);
    }

    #rp {
      background: linear-gradient(90deg, #2fd45a, #ffd23f, #e63946);
    }

    #cd {
      position: absolute;
      top: 30%;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 6em;
      color: #fff;
    }

    #ww {
      position: absolute;
      top: 22%;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 2em;
      color: #e63946;
      display: none;
      animation: bl .5s infinite;
    }

    @keyframes bl {
      50% { opacity: .2; }
    }

    #tst {
      position: absolute;
      top: 18%;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 1.4em;
      color: #ffd23f;
      opacity: 0;
    }

    #tst.on {
      animation: tt 1.6s;
    }

    @keyframes tt {
      0% { opacity: 0; }
      10%, 70% { opacity: 1; }
      100% { opacity: 0; }
    }

    #hint {
      position: absolute;
      bottom: .3em;
      left: 11em;
      font: .45em system-ui;
      opacity: .7;
    }

    #res {
      display: none;
      justify-content: center;
      align-items: center;
      background: rgba(5, 8, 18, .85);
    }

    .rb {
      background: #10162a;
      border: 2px solid #333b58;
      padding: 1em 1.5em;
      min-width: min(90%, 30em);
      text-align: center;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font: .7em system-ui;
      margin: .6em 0;
    }

    td {
      padding: .25em .4em;
      border-bottom: 1px solid #2a3150;
      text-align: left;
    }

    tr.me {
      color: #ffd23f;
      font-weight: 700;
    }
  </style>
</head>
<body>

  <div id="menu" class="ov">
    <div class="L">
      <div>
        <h1>APEX RACING 3D</h1>
        <div class="sub">Apni gaadi chuno · 16 vehicles</div>
      </div>
      <div id="grid"></div>
    </div>
    <div class="R">
      <div id="st"></div>
      <div class="row" id="modes"></div>
      <button id="start">START RACE</button>
      <div class="sub">
        W/↑ gas · S/↓ brake-reverse · A D / ← → steer<br>
        SHIFT nitro · SPACE handbrake · H police horn · E engine on/off · C camera
      </div>
    </div>
  </div>

  <div id="hud">
    <div id="pos"></div>
    <div id="lp"></div>
    <div id="sc"></div>
    <canvas id="map" width="180" height="180"></canvas>
    <div id="spd">
      <span id="sv">0</span> <small>km/h</small>
      <div id="gr">N</div>
    </div>
    <div id="bars">
      NITRO (SHIFT)
      <div class="bar"><div id="nt"></div></div>
      RPM
      <div class="bar"><div id="rp"></div></div>
    </div>
    <div id="cd"></div>
    <div id="ww">WRONG WAY!</div>
    <div id="tst"></div>
    <div id="hint">W gas · S brake · SHIFT nitro · SPACE handbrake · H horn · C camera</div>
  </div>

  <div id="res" class="ov">
    <div class="rb">
      <h1 id="rt">RESULTS</h1>
      <div id="rs" class="sub"></div>
      <table id="tb"></table>
      <div class="row">
        <button id="again">RACE AGAIN</button>
        <button id="gar" style="background:#fff">GARAGE</button>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script>
    const $ = id => document.getElementById(id),
          cl = (v, a, b) => Math.max(a, Math.min(b, v)),
          wrap = a => {
            while (a > Math.PI) a -= 2 * Math.PI;
            while (a < -Math.PI) a += 2 * Math.PI;
            return a;
          },
          rnd = (a, b) => a + Math.random() * (b - a),
          pick = a => a[Math.random() * a.length | 0];

    const SC = .6, HW = 9, keys = {};

    /* ---------- vehicles (real-world style specs) ---------- */
    const V = [
      { n: 'Koenigsegg Jesko', col: 0xff7a00, k: 'h', L: 4.6, W: 2.05, hy: .82, ry: 1.08, wr: .36, top: 480, z: 2.5, hd: 9.5, eg: [8, 900, 8500, 7, 'p', 1], es: '5.0L twin-turbo V8', wing: 2, stripe: 0xffffff, hs: 's' },
      { n: 'Bugatti Chiron', col: 0x1f4fd8, k: 'h', L: 4.5, W: 2, hy: .85, ry: 1.2, wr: .37, top: 420, z: 2.4, hd: 8.2, eg: [16, 800, 6700, 7, 'p', 1], es: '8.0L quad-turbo W16', wing: 1, cacc: 0x0a0a0a, gr: 'h', hs: 's' },
      { n: 'Lamborghini Sian', col: 0x3ab54a, k: 'h', L: 4.9, W: 2.1, hy: .8, ry: 1.1, wr: .37, top: 350, z: 2.8, hd: 8.6, eg: [12, 900, 8500, 7, 'p', 0], es: '6.5L V12 + hybrid', wing: 1, hs: 'y', stripe: 0x111111 },
      { n: 'Mercedes G-Wagon', col: 0x1c1c1f, k: 'b', L: 4.6, W: 2, hy: 1.15, ry: 1.95, wr: .45, cab: .62, top: 220, z: 4.5, hd: 5.5, eg: [8, 700, 6000, 6, 'p', 1], es: '4.0L twin-turbo V8', sp: 1, fl: 1, hs: 'r', gr: 'w' },
      { n: 'Toyota LC 300', col: 0xf2f2f2, k: 'b', L: 5, W: 2, hy: 1.15, ry: 1.95, wr: .46, cab: .6, top: 210, z: 8, hd: 5.5, eg: [6, 700, 6000, 6, 'p', 1], es: '3.5L twin-turbo V6', rl: 1, hs: 's', gr: 'w' },
      { n: 'Mahindra Bolero', col: 0xe8e8e8, k: 'b', L: 3.99, W: 1.7, hy: 1.1, ry: 1.85, wr: .4, cab: .55, top: 125, z: 15, hd: 4, eg: [3, 800, 4500, 5, 'd', 0], es: '1.5L 3-cyl diesel', sp: 1, bar: 1, hs: 'r', gr: 'w' },
      { n: 'Mahindra Thar', col: 0xc4272c, k: 'b', L: 3.99, W: 1.82, hy: 1.05, ry: 1.85, wr: .43, cab: .5, top: 155, z: 11, hd: 5, eg: [4, 800, 4500, 6, 'd', 1], es: '2.2L mHawk diesel', sp: 1, fl: 1, hs: 'r', gr: 's' },
      { n: 'Mahindra Scorpio S11', col: 0x30343a, k: 'b', L: 4.46, W: 1.82, hy: 1.15, ry: 1.9, wr: .42, cab: .58, top: 165, z: 13, hd: 4.5, eg: [4, 800, 4500, 6, 'd', 1], es: '2.2L mHawk diesel', rl: 1, hs: 's', gr: 'w' },
      { n: 'Mahindra Scorpio N', col: 0x0e0e12, k: 'b', L: 4.66, W: 1.92, hy: 1.2, ry: 1.95, wr: .45, cab: .6, top: 180, z: 10.5, hd: 5.5, eg: [4, 800, 4500, 6, 'd', 1], es: '2.2L mStallion diesel', rl: 1, hs: 's', gr: 'w' },
      { n: 'Mahindra BE.06', col: 0x2bb5a8, k: 'b', L: 4.37, W: 1.9, hy: 1, ry: 1.65, wr: .43, cab: .5, top: 200, z: 6.7, hd: 7, eg: [0, 0, 0, 1, 'e', 0], es: 'Electric · light-bar design', lb: 1, hs: 's' },
      { n: 'Tata Safari', col: 0x3e5c3a, k: 'b', L: 4.67, W: 1.92, hy: 1.15, ry: 1.92, wr: .44, cab: .62, top: 190, z: 11, hd: 5.5, eg: [4, 800, 4500, 6, 'd', 1], es: '2.0L Kryotec diesel', rl: 1, lb: 1 },
      { n: 'Tata Harrier', col: 0xb8581e, k: 'b', L: 4.6, W: 1.92, hy: 1.1, ry: 1.85, wr: .44, cab: .55, top: 180, z: 11, hd: 6, eg: [4, 800, 4500, 6, 'd', 1], es: '2.0L Kryotec diesel', lb: 1, rl: 1 },
      { n: 'Hyundai Creta', col: 0x777c8a, k: 'b', L: 4.3, W: 1.8, hy: 1.05, ry: 1.8, wr: .42, cab: .55, top: 190, z: 9, hd: 6.5, eg: [4, 800, 6500, 7, 'p', 1], es: '1.5L turbo petrol', lb: 1, hs: 's' },
      { n: 'Toyota Fortuner', col: 0xf5f5f5, k: 'b', L: 4.8, W: 1.85, hy: 1.2, ry: 1.95, wr: .46, cab: .6, top: 185, z: 10, hd: 5.5, eg: [4, 800, 4000, 6, 'd', 1], es: '2.8L diesel', rl: 1, gr: 'w', hs: 's' },
      { n: 'Maruti Baleno', col: 0x2c6fbb, k: 'b', L: 3.99, W: 1.75, hy: .95, ry: 1.5, wr: .37, cab: .6, top: 170, z: 12, hd: 7, eg: [4, 700, 6000, 5, 'p', 0], es: '1.2L petrol', hs: 's' },
      { n: 'Maruti Brezza', col: 0xa83232, k: 'b', L: 3.99, W: 1.79, hy: 1.05, ry: 1.7, wr: .4, cab: .58, top: 165, z: 11.5, hd: 6.5, eg: [4, 700, 6000, 6, 'p', 0], es: '1.5L petrol', rl: 1, hs: 's' }
    ];

    const MD = {
      easy: { n: 5, sk: .8, laps: 2, slot: 2 },
      medium: { n: 7, sk: .92, laps: 3, slot: 5 },
      hard: { n: 9, sk: 1.02, laps: 3, slot: 99 }
    };

    /* ---------- audio: synthesized engines (no files) ---------- */
    let AC, MG, SQ, WN, NT, hornO, hornG, lastThud = 0;

    function audio() {
      if (AC) { AC.resume(); return; }
      AC = new (window.AudioContext || window.webkitAudioContext)();
      const cp = AC.createDynamicsCompressor();
      cp.connect(AC.destination);
      MG = AC.createGain();
      MG.gain.value = .75;
      MG.connect(cp);

      const n = AC.sampleRate * 2, b = AC.createBuffer(1, n, AC.sampleRate), d = b.getChannelData(0);
      for (let i = 0; i < n; i++) d[i] = Math.random() * 2 - 1;

      const mk = (type, fq, q) => {
        const s = AC.createBufferSource();
        s.buffer = b;
        s.loop = true;
        const f = AC.createBiquadFilter();
        f.type = type;
        f.frequency.value = fq;
        f.Q.value = q;
        const g = AC.createGain();
        g.gain.value = 0;
        s.connect(f);
        f.connect(g);
        g.connect(MG);
        s.start();
        return { f, g };
      };

      SQ = mk('bandpass', 1500, 8);
      WN = mk('lowpass', 600, .7);
      NT = mk('bandpass', 900, 1.2);

      hornO = AC.createOscillator();
      const hf = AC.createBiquadFilter();
      hf.type = 'lowpass';
      hf.frequency.value = 2200;
      hornG = AC.createGain();
      hornG.gain.value = 0;
      hornO.type = 'sawtooth';
      hornO.connect(hf);
      hf.connect(hornG);
      hornG.connect(MG);
      hornO.start();
    }

    function tone(type, f0, f1, dur, vol, dl = 0) {
      const o = AC.createOscillator(), g = AC.createGain(), t0 = AC.currentTime + dl;
      o.type = type;
      o.frequency.setValueAtTime(f0, t0);
      o.frequency.exponentialRampToValueAtTime(Math.max(1, f1), t0 + dur);
      g.gain.setValueAtTime(vol, t0);
      g.gain.exponentialRampToValueAtTime(.001, t0 + dur);
      o.connect(g);
      g.connect(MG);
      o.start(t0);
      o.stop(t0 + dur + .05);
    }

    function noise(dur, vol, fc) {
      const n = (AC.sampleRate * dur) | 0, b = AC.createBuffer(1, n, AC.sampleRate), d = b.getChannelData(0);
      for (let i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / n);
      const s = AC.createBufferSource(), f = AC.createBiquadFilter(), g = AC.createGain();
      s.buffer = b;
      f.type = 'lowpass';
      f.frequency.setValueAtTime(fc, AC.currentTime);
      f.frequency.exponentialRampToValueAtTime(60, AC.currentTime + dur);
      g.gain.value = vol;
      s.connect(f);
      f.connect(g);
      g.connect(MG);
      s.start();
    }

    const SFX = {
      click() { tone('square', 1900, 900, .05, .14); },
      thud() { tone('sine', 110, 40, .25, .5); noise(.15, .3, 800); },
      b1() { tone('sine', 620, 620, .25, .25); },
      b2() { tone('sine', 1240, 1240, .5, .3); },
      off() { tone('sawtooth', 110, 28, .7, .12); noise(.3, .1, 500); },
      crank() { tone('sawtooth', 48, 92, 1, .14); tone('square', 24, 26, 1, .05); },
      bov() { noise(.3, .3, 7000); }
    };

    const S = n => { if (AC) SFX[n](); };

    function mkVoice(cfg, rich) {
      const o1 = AC.createOscillator(), o2 = AC.createOscillator(), f = AC.createBiquadFilter(), g = AC.createGain(), v = { cfg, o1, o2, f, g };
      const ev = cfg.e === 'e';
      o1.type = ev ? 'sine' : 'sawtooth';
      o2.type = ev ? 'triangle' : 'square';
      f.type = 'lowpass';
      g.gain.value = 0;

      if (rich) {
        const sh = AC.createWaveShaper(), cv = new Float32Array(256);
        for (let i = 0; i < 256; i++) cv[i] = Math.tanh((i / 128 - 1) * 3);
        sh.curve = cv;
        o1.connect(sh);
        o2.connect(sh);
        sh.connect(f);
      } else {
        o1.connect(f);
        o2.connect(f);
      }

      f.connect(g);
      g.connect(MG);
      o1.start();
      o2.start();

      if (cfg.e === 'd') {
        const l = AC.createOscillator(), lg = AC.createGain();
        lg.gain.value = .05;
        l.connect(lg);
        lg.connect(g.gain);
        l.start();
        v.l = l;
      }

      if (cfg.tb && rich) {
        const tt = AC.createOscillator(), tg = AC.createGain();
        tt.type = 'sine';
        tt.gain.value = 0;
        tt.connect(tg);
        tg.connect(MG);
        tt.start();
        v.t = tt;
        v.tg = tg;
      }
      return v;
    }

    function setVoice(v, rf, thr, vol) {
      const n = AC.currentTime, c = v.cfg;
      let f1, fc;
      if (c.e === 'e') {
        f1 = 160 + rf * 1500;
        fc = 3500;
        v.o1.frequency.setTargetAtTime(f1, n, .05);
        v.o2.frequency.setTargetAtTime(f1 * 2, n, .05);
      } else {
        const rpm = c.idle + (c.red - c.idle) * rf;
        f1 = c.cyl * rpm / 120;
        fc = f1 * (2.5 + thr * 3) + 150;
        v.o1.frequency.setTargetAtTime(f1, n, .04);
        v.o2.frequency.setTargetAtTime(f1 * .5, n, .04);
      }
      v.f.frequency.setTargetAtTime(Math.min(fc, c.e === 'd' ? 1800 : 6000), n, .06);
      v.g.gain.setTargetAtTime(vol * (.05 + .12 * thr), n, .05);
      if (v.l) v.l.frequency.setTargetAtTime(Math.max(8, f1 / 3), n, .05);
      if (v.t) {
        v.tg.gain.setTargetAtTime(vol * .02 * thr * rf, n, .05);
        v.t.frequency.setTargetAtTime(1500 + 4500 * rf, n, .1);
      }
    }

    function killVoice(v) {
      try {
        v.o1.stop();
        v.o2.stop();
        if (v.l) v.l.stop();
        if (v.t) v.t.stop();
        v.g.disconnect();
        if (v.tg) v.tg.disconnect();
      } catch (e) {}
    }

    function engTick(c, thr, dt) {
      if (!AC || !c.v) return;
      const cfg = c.cfg, vfr = cl(Math.max(0, c.vf) / c.vt, 0, 1.05);
      let rf;
      if (cfg.e === 'e') rf = vfr;
      else {
        const G = cfg.G, g = Math.min(G - 1, Math.floor(vfr * G * .97)), gf = vfr * G * .97 - g, lo = .35 + .3 * g / G;
        rf = lo + (1 - lo) * cl(gf, 0, 1);
        if (vfr < .03) rf = .18 + .75 * thr;
        c.gear = g + 1;
      }
      c.rf += (rf - c.rf) * Math.min(1, dt * 9);
      const on = c.es === 'on', d = c.isP ? 0 : Math.hypot(c.x - cam.position.x, c.z - cam.position.z);
      setVoice(c.v, on ? Math.max(c.rf, .8 * Math.max(0, c.blip)) : 0, on ? thr : 0, on ? (c.isP ? 1 : .45 * Math.pow(cl(1 - d / 170, 0, 1), 2)) : 0);
      if (c.isP && c.lastThr > .6 && thr < .1 && c.rf > .6 && cfg.e !== 'd' && cfg.e !== 'e') noise(.1, .22, 2600);
      c.lastThr = thr;
    }

    function sfxTick(c) {
      if (!AC) return;
      const n = AC.currentTime, vf = Math.abs(c.vf);
      hornG.gain.setTargetAtTime(keys.KeyH ? .16 : 0, n, .03);
